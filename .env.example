# Copier ce fichier en .env puis adapter les valeurs : cp .env.example .env
# .env contient des secrets : ne jamais le versionner (déjà dans .gitignore)

# Utilisateur de la base de données
DB_USER=root

# Mot de passe de l'utilisateur
DB_PASSWORD=change_me

# Nom de la base de données
DB_NAME=ecommerce

# Chemin du dossier des fichiers de logs
LOG_DIR=./logs
